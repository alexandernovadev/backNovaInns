# ===== Base de datos =====
MONGODB_URI=mongodb://localhost:27017/nova-inns

# ===== Autenticacion (JWT) =====
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# ===== Servidor =====
PORT=3000
# Origenes permitidos por CORS, separados por coma (sin espacios)
CORS_ORIGINS=http://localhost:4200

# ===== Cloudinary (fotos de apartamentos) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

